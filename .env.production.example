# Template .env untuk server (hosting). Salin menjadi .env di server, lalu isi bagian bertanda <...>.
# Jangan pernah meng-commit .env berisi kata sandi asli.

APP_NAME=SIMAGTI
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://<domain-anda>

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Database MySQL dari cPanel (MySQL Databases). Nama database dan user biasanya berawalan nama akun cPanel.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=<akun>_simagti
DB_USERNAME=<akun>_simagti
DB_PASSWORD=<kata-sandi-database>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Email dikirim langsung saat kejadian (tidak lewat antrean), jadi tidak perlu queue worker.
QUEUE_CONNECTION=sync
CACHE_STORE=database

# SMTP dari hosting (cPanel > Email Accounts > buat noreply@<domain-anda> > Connect Devices).
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.<domain-anda>
MAIL_PORT=465
MAIL_USERNAME=noreply@<domain-anda>
MAIL_PASSWORD=<kata-sandi-email>
MAIL_FROM_ADDRESS="noreply@<domain-anda>"
MAIL_FROM_NAME="${APP_NAME}"

# Identitas kampus di surat, sertifikat, dan laporan
CAMPUS_UNIVERSITY="Universitas Satya Mandala"
CAMPUS_FACULTY="Fakultas Ilmu Komputer"
CAMPUS_PROGRAM="Program Studi Teknik Informatika"
CAMPUS_SHORT=USM
CAMPUS_CITY=Jakarta
CAMPUS_ADDRESS="Jl. Pendidikan Raya No. 45, Jakarta Timur 13220"
CAMPUS_LETTER_CODE=KP/FIK-USM
